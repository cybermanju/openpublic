#!/usr/bin/env bash
# openpublic — run opencode inside an always-fresh container with your host
# GitHub credentials passed through automatically.
#
# Usage:
#   openpublic        attach (or create) the "opencode" container in $PWD's workspace
#   openpublic -r     recreate the container from scratch (keeps opencode data dirs)
#
# Auth safety:
#   - Reads the ACTIVE gh token from the HOST keyring at launch time only.
#   - Writes it to /tmp/opencode-gh-token (0600) and mounts it READ-ONLY
#     into the container at /run/gh-token.
#   - Inside: git uses a credential helper that reads /run/gh-token, and
#     `opencode` runs with GH_TOKEN set. Nothing is written to container disk.
#
# Non-root guarantee:
#   - Container runs as user "dev" with your host UID/GID (UID_GID env, default 1000:1000).
#   - opencode data dirs mount to /home/dev/*, workspace to /workspace.
#   - Files created inside the container are owned by YOU on the host, never root.
#     (The container entrypoint installs remaining tools as root first; runtime
#      commands and opencode itself always run with --user dev.)
set -euo pipefail

reset=0
no_auth=0
passthrough=()
while [ $# -gt 0 ]; do
  case "$1" in
    -r|--reset) reset=1 ;;
    -u|--no-auth) no_auth=1 ;;
    -h|--help)
      cat <<EOF
Usage: openpublic [-r|--reset] [-u|--no-auth] [-- opencode-args...]
  -r, --reset   recreate container from scratch (new IP, wiped state) — resets limit bans
  -u, --no-auth run unauthenticated (no GH_TOKEN) — bypasses host GitHub server-side cap
  --            everything after is passed to opencode inside the container
Examples:
  openpublic -r -u -- --prompt "hello"
  openpublic -r --continue
EOF
      exit 0 ;;
    --) shift; passthrough+=("$@"); break ;;
    *) passthrough+=("$1") ;;
  esac
  shift
done

log() { echo "[openpublic] $*"; }
die() { echo "[openpublic] ERROR: $*" >&2; exit 1; }

command -v docker >/dev/null || die "docker is required"
if [ "$no_auth" -eq 0 ]; then
  command -v gh >/dev/null || die "gh CLI is required (https://cli.github.com)"
fi

# ── constants ────────────────────────────────────────────────────────────────
CONTAINER=opencode
NET_NAME=opencode-net
NET_SUBNET=172.20.0.0/16
IMAGE="${OPENPUBLIC_IMAGE:-opencode-warp}"
UID_GID="${OPENPUBLIC_UID_GID:-$(id -u):$(id -g)}"
USER_NAME=dev
HOME_IN=/home/dev
TOKEN_FILE=/tmp/opencode-gh-token
HOST_WORKSPACE="${OPENPUBLIC_WORKSPACE:-$(dirname "$PWD")}"
WORKDIR_BASE=/workspace

# ── safety guard: never mount/chown host system dirs ───────────────────────
# Root cause of 2026-10-08 incident: running `openpublic` from `/` sets
# HOST_WORKSPACE=/, mounts host `/` at /workspace, then
# `chown -R 1000:1000 /workspace` inside the container recursively chowns
# the whole host (broke /usr, /etc, /var/lib/docker, sudo). Refuse that.
HOST_WORKSPACE="$(realpath -m "$HOST_WORKSPACE")"
case "$HOST_WORKSPACE" in
  "/"|"/home"|"/etc"|"/usr"|"/var"|"/opt"|"/srv"|"/boot"|"/root"|"/run"|"/tmp"|"/proc"|"/sys"|"/dev")
    die "refusing to mount host system dir '$HOST_WORKSPACE' as workspace (cd into a project subdir, e.g. ~/CyberManju, or set OPENPUBLIC_WORKSPACE=/home/hautly)"
    ;;
esac
case "$HOST_WORKSPACE" in
  /home/*) ;;
  *) die "refusing workspace '$HOST_WORKSPACE' outside /home (set OPENPUBLIC_WORKSPACE to a safe parent under /home)" ;;
esac

# ── extract host gh auth (before anything destructive) ───────────────────────
# Skipped with --no-auth: opencode then runs unauthenticated (no GH_TOKEN),
# so it is NOT tied to your host GitHub account and its server-side cap.
if [ "$no_auth" -eq 0 ]; then
  if ! gh auth status >/dev/null 2>&1; then
    die "gh is not authenticated on host. Run 'gh auth login' first."
  fi
  umask 077
  gh auth token >"$TOKEN_FILE"
  [ -s "$TOKEN_FILE" ] || die "could not extract gh token"
  GH_USER="$(gh api user --jq .login 2>/dev/null || echo "gh-token")"
else
  GH_USER="unauthenticated"
fi

# ── reset: stop + remove container (mutable opencode state wiped) ─────────────
# Remember the current IP so a -r recreation never reuses it (new IP → new
# Cloudflare/WARP identity → IP-based opencode/provider limits reset).
# Wipe mutable state dirs so tabs + rate-limit bans actually vanish on -r.
OLD_IP=""
if [ "$reset" -eq 1 ]; then
  log "Recreating $CONTAINER container (mutable state wiped, owner: $UID_GID)..."
  OLD_IP="$(docker inspect --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$CONTAINER" 2>/dev/null || true)"
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
  reset_dirs=(
    "$HOME/.local/share/opencode"
    "$HOME/.local/state/opencode"
    "$HOME/.cache/opencode"
  )
  for d in "${reset_dirs[@]}"; do
    if [ -d "$d" ]; then
      find "$d" -mindepth 1 -exec rm -rf {} + 2>/dev/null || true
    fi
  done
else
  docker inspect "$CONTAINER" >/dev/null 2>&1 && log "Container exists, attaching..." || true
fi

# ── create container if missing ───────────────────────────────────────────────
if ! docker inspect "$CONTAINER" >/dev/null 2>&1; then
  docker network inspect "$NET_NAME" >/dev/null 2>&1 || \
    docker network create --subnet "$NET_SUBNET" "$NET_NAME" >/dev/null

  # pick a free IP in the subnet; never reuse OLD_IP (so -r always yields a new IP)
  used="$(docker network inspect "$NET_NAME" \
      --format '{{range .Containers}}{{.IPv4Address}} {{end}}' 2>/dev/null || true)"

  OCP_IP=""
  candidates=()
  for i in $(seq 10 254); do
    test_ip="172.20.0.$i"
    [ "$test_ip" = "$OLD_IP" ] && continue
    grep -q "$test_ip/" <<<"$used" && continue
    candidates+=("$test_ip")
  done
  [ "${#candidates[@]}" -gt 0 ] || die "no free IP in $NET_SUBNET"
  OCP_IP="${candidates[$(( RANDOM % ${#candidates[@]} ))]}"

  log "Creating container at $OCP_IP (user $USER_NAME uid:gid $UID_GID)..."
  TOKEN_MOUNT=""
  OP_BIN_MOUNT="-v $HOME/.opencode/bin/opencode:/usr/local/bin/opencode:ro"
  if [ "$no_auth" -eq 0 ]; then
    # Authenticated: mount host's opencode data (persistent sessions + provider auth)
    OP_DATA_MOUNT="-v $HOME/.opencode:$HOME_IN/.opencode"
    SHARE_MOUNT="-v $HOME/.local/share/opencode:$HOME_IN/.local/share/opencode"
    STATE_MOUNT="-v $HOME/.local/state/opencode:$HOME_IN/.local/state/opencode"
    CACHE_MOUNT="-v $HOME/.cache/opencode:$HOME_IN/.cache/opencode"
    CONFIG_MOUNT="-v $HOME/.config/opencode:$HOME_IN/.config/opencode"
    TOKEN_MOUNT="-v $TOKEN_FILE:/run/gh-token:ro"
  else
    # Unauthenticated: fresh empty data dirs → new device ID, bypasses server-side limit
    TMP_ROOT="$(mktemp -d)"
    OP_DATA_MOUNT="-v $TMP_ROOT/opencode:$HOME_IN/.opencode"
    SHARE_MOUNT="-v $TMP_ROOT/share/opencode:$HOME_IN/.local/share/opencode"
    STATE_MOUNT="-v $TMP_ROOT/state/opencode:$HOME_IN/.local/state/opencode"
    CACHE_MOUNT="-v $TMP_ROOT/cache/opencode:$HOME_IN/.cache/opencode"
    CONFIG_MOUNT="-v $TMP_ROOT/config/opencode:$HOME_IN/.config/opencode"
  fi
  # shellcheck disable=SC2086
  docker run -d --name "$CONTAINER" \
    --network "$NET_NAME" --ip "$OCP_IP" \
    --cap-add NET_ADMIN --device /dev/net/tun \
    -e HOME="$HOME_IN" \
    -v "$HOST_WORKSPACE":"$WORKDIR_BASE" \
    $OP_BIN_MOUNT \
    $OP_DATA_MOUNT \
    $SHARE_MOUNT \
    $STATE_MOUNT \
    $CACHE_MOUNT \
    $CONFIG_MOUNT \
    $TOKEN_MOUNT \
    -p 13000:3000 -p 13213:3213 -p 14096:4096 -p 17654:7654 \
    "$IMAGE" >/dev/null

  # Wait for entrypoint (WARP setup + sleep infinity) to reach running state
  log "Waiting for container to be ready..."
  ready=0
  for i in $(seq 1 90); do
    if docker inspect "$CONTAINER" --format '{{.State.Running}}' 2>/dev/null | grep -q true; then
      ready=1; break
    fi
    sleep 1
  done
  [ "$ready" = 1 ] || die "container did not reach running state"
fi

# ── bootstrap user (idempotent; runs as root inside, once) ────────────────────
docker exec -e UID_GID="$UID_GID" -e USER_NAME="$USER_NAME" -e HOME_IN="$HOME_IN" \
  "$CONTAINER" sh -c '
    set -e
    UID_="${UID_GID%%:*}"; GID_="${UID_GID##*:}"
    if ! id -u "$USER_NAME" >/dev/null 2>&1; then
      if ! getent group "$GID_" >/dev/null; then groupadd -g "$GID_" "$USER_NAME"; fi
      useradd -u "$UID_" -g "$GID_" -m -d "$HOME_IN" -s /bin/bash "$USER_NAME" 2>/dev/null \
        || useradd -u "$UID_" -g "$GID_" -d "$HOME_IN" -s /bin/bash "$USER_NAME"
    fi
    mkdir -p "$HOME_IN/.opencode" "$HOME_IN/.config/opencode" "$HOME_IN/.local/share/opencode" \
             "$HOME_IN/.local/state/opencode" "$HOME_IN/.cache/opencode"
  ' || die "could not bootstrap user in container"

# ── ensure git + gh inside (best-effort; binary gh, not apt) — as root once ───
# Skipped with --no-auth: no git/gh needed when opencode runs unauthenticated.
if [ "$no_auth" -eq 0 ]; then
  if ! docker exec "$CONTAINER" sh -c 'command -v git >/dev/null'; then
    log "git missing inside container; installing (may take ~1-2 min)..."
    if timeout 420 docker exec "$CONTAINER" sh -c '
      DEBIAN_FRONTEND=noninteractive apt-get update -o Acquire::Retries=3 2>&1 | tail -2
      DEBIAN_FRONTEND=noninteractive apt-get install -y git 2>&1 | tail -2
      command -v git
    '; then
      log "git installed."
    else
      log "WARNING: git install failed/timed out; git ops inside container won't authenticate."
    fi
  fi
  if ! docker exec "$CONTAINER" sh -c 'command -v gh >/dev/null'; then
    log "gh missing inside container; installing official binary (fast, no apt)..."
    GHV="$(gh --version | head -1 | awk '{print $3}')"
    docker exec "$CONTAINER" sh -c "
      curl -fsSL -o /tmp/gh.tgz https://github.com/cli/cli/releases/download/v${GHV}/gh_${GHV}_linux_amd64.tar.gz &&
      tar -xzf /tmp/gh.tgz -C /tmp && install -m 0755 /tmp/gh_${GHV}_linux_amd64/bin/gh /usr/local/bin/gh &&
      rm -rf /tmp/gh.tgz /tmp/gh_${GHV}_linux_amd64
    " >/dev/null 2>&1 && log "gh ${GHV} installed." || log "gh binary install skipped; GIT auth still works."
  fi
fi

# ── ensure newest opencode inside (container-local, checked each launch) ───────
# OpenCode 2 ships as a npm binary package (@opencode/cli-<target>). On every
# launch, compare the latest published version against the copy installed in the
# container and (re)install only when it is missing or outdated.
OCP_LATEST="$(curl -fsSL --max-time 15 https://opencode.ai/update/api/latest/cli/npm 2>/dev/null \
  | sed -n 's/.*"version":"\([^"]*\)".*/\1/p' || true)"
if [ -z "$OCP_LATEST" ]; then
  # offline fallback: match whatever the host is running
  OCP_LATEST="$(opencode --version 2>/dev/null | sed -n 's/[^0-9]*\([0-9][0-9.]*\).*/\1/p' || true)"
fi
OCP_INSTALLED=""
if docker exec "$CONTAINER" test -x /usr/local/bin/opencode >/dev/null 2>&1; then
  OCP_INSTALLED="$(docker exec "$CONTAINER" /usr/local/bin/opencode --version 2>/dev/null \
    | sed -n 's/[^0-9]*\([0-9][0-9.]*\).*/\1/p' || true)"
fi

# ── ensure workspace + data dirs writable by dev (owner match = your host uid) ─
docker exec "$CONTAINER" sh -c "chown -R $UID_GID $WORKDIR_BASE $HOME_IN" 2>/dev/null || true

# ── wire credentials as dev (token readable by all container users; 0600 host) ─
# Skipped with --no-auth: no GH_TOKEN passed, no git credential helper.
if [ "$no_auth" -eq 0 ]; then
  docker exec --user "$USER_NAME" -e GH_USER="$GH_USER" -e HOME="$HOME_IN" "$CONTAINER" sh -c '
    if command -v git >/dev/null; then
      git config --global credential.helper "!f() { test -r /run/gh-token && printf \"username=%s\\npassword=%s\\n\" \"$GH_USER\" \"$(cat /run/gh-token)\"; }; f"
      git config --global --get-all credential.helper >/dev/null
    fi
  ' || die "could not wire git credentials inside container"
  log "git credential helper wired (user: $USER_NAME)."
else
  log "running unauthenticated (no GH_TOKEN, no git credential helper)."
fi

# ── pick workspace dir + attach ───────────────────────────────────────────────
cd_inside="${WORKDIR_BASE}/$(basename "$PWD")"
docker exec "$CONTAINER" test -d "$cd_inside" 2>/dev/null || cd_inside="$WORKDIR_BASE"
log "Attaching opencode in $cd_inside (user: $USER_NAME, gh identity: $GH_USER)..."

if [ "$no_auth" -eq 0 ]; then
  EXEC_ARGS=(docker exec -it --user "$USER_NAME" -e "HOME=$HOME_IN" -e "GH_TOKEN=$(cat "$TOKEN_FILE")")
else
  EXEC_ARGS=(docker exec -it --user "$USER_NAME" -e "HOME=$HOME_IN")
fi
EXEC_CMD="${OPENPUBLIC_EXEC_CMD:-opencode}"
# shell-quote passthrough args so they reach opencode verbatim inside sh -c
OC_ARGS=""
for _a in "${passthrough[@]+"${passthrough[@]}"}"; do
  _a="${_a//\'/\'\\\'\'}"
  OC_ARGS="$OC_ARGS '$_a'"
done
exec "${EXEC_ARGS[@]}" "$CONTAINER" sh -c "cd '$cd_inside' && export PATH=\"/usr/local/bin:\$HOME/.opencode/bin:\$PATH\" && exec $EXEC_CMD$OC_ARGS"
